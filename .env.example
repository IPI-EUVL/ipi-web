# Host paths and chamber network
DATASET_HOST_PATH=/srv/ipi/datasets
LOG_HOST_PATH=/srv/ipi/logs
ECS_HOST=127.0.0.1

# API process ownership. Match the account that can read/write DATASET_HOST_PATH.
API_UID=1000
API_GID=1000

# Public HTTP binding. HTTPS will be added after certificate ownership is known.
HTTP_PORT=80
GRAFANA_HOST_PORT=3000
# Keep Grafana loopback-only unless LAN/VPN testing is explicitly required.
GRAFANA_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432

# Webview configuration
WEBVIEW_CRITICAL_SUBSYSTEMS=exposure,queue,oscilloscope,sample_motion,target,laser
WEBVIEW_LIVE_STALE_AFTER=10
WEBVIEW_HISTORY_STALE_AFTER=15
WEBVIEW_SSE_HEARTBEAT_INTERVAL=15
WEBVIEW_DOCS_ENABLED=false
WEBVIEW_TRUSTED_HOSTS=live.ipi.illinois.edu,localhost,127.0.0.1

# Frontend hot-reload binding. Keep loopback for normal local development.
FRONTEND_DEV_BIND_ADDRESS=127.0.0.1
FRONTEND_DEV_PORT=5173

# Existing persistent volume names from the legacy dashboard Compose project
GRAFANA_DATA_VOLUME=dashboard_ipi-dashboard-persist
POSTGRES_DATA_VOLUME=dashboard_ipi-dashboard-db-persist

# Grafana/PostgreSQL settings. See README.md before rotating an existing volume.
POSTGRES_USER=ipi-euvl
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=ipi-data
PGUSER=ipi-euvl
GF_SERVER_DOMAIN=localhost
GF_SERVER_ROOT_URL=http://localhost:3000/
GF_SERVER_PROTOCOL=http
GF_SECURITY_COOKIE_SECURE=false
